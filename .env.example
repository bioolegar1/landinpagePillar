# Copie para .env.local (nunca commitado) para testar o envio de e-mail em desenvolvimento.
# Em produção, cadastre essas mesmas variáveis em: Vercel → Project Settings → Environment Variables.

# Dados de acesso SMTP do e-mail que vai ENVIAR a notificação (ex: contato@inforplace.com.br)
SMTP_HOST=smtp.seuservidor.com.br
SMTP_PORT=587
SMTP_USER=contato@inforplace.com.br
SMTP_PASSWORD=

# Opcional: remetente exibido no e-mail, se diferente de SMTP_USER
SMTP_FROM=contato@inforplace.com.br

# Para onde a notificação de novo contato deve ser enviada
CONTACT_TO_EMAIL=contato@inforplace.com.br
